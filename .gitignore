# Public source files are listed explicitly so local sessions, APKs, profiles,
# research, and future scratch files cannot be added by `git add .`.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
!/LICENSE
!/assets/
/assets/*
!/assets/banner.jpg
!/README.md
!/README.no.md
!/CHANGELOG.md
!/CHANGELOG.no.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/src/
/src/*
!/src/browser.js
!/src/files.js
!/src/login-mobile.js
!/src/mobile-auth.js
!/src/mobile-client.js
!/src/portal.js
!/src/sending.js
!/src/server.js
!/test/
/test/*
!/test/mobile-auth.test.js
!/test/portal.test.js
!/test/sending.test.js
!/test/server.test.js
